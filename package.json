{
  "name": "ai-coding-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/main.ts",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts spikes/phase0/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "react": "^19.2.0", "react-dom": "^19.2.0" },
  "devDependencies": { "@types/node": "^24.0.0", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "esbuild": "^0.27.0", "typescript": "^5.9.0" }
}
